NODE_ENV=development  # 'development', 'test', 'production'
POSTGRES_USER=ceps
POSTGRES_PASSWORD=ceps
POSTGRES_DB=ceps_proximos
POSTGRES_PORT=5432
API_PORT=3000
# DATABASE_URL=postgresql://ceps:ceps@localhost:5432/ceps_proximos
PORT=3000
SEARCH_RADIUS_KM=1
SEED_UFS=
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
CACHE_TTL_ADDRESS_SECONDS=2592000
CACHE_TTL_RESULT_SECONDS=86400
CACHE_TTL_NOT_FOUND_SECONDS=3600
